#include <iostream>
#include <fstream>
#include <string>
using namespace std;

class Student {
public:
    int roll;
    string name;
    float marks;

    void input() {
        cout << "Enter Roll No: ";
        cin >> roll;
        cin.ignore();
        cout << "Enter Name: ";
        getline(cin, name);
        cout << "Enter Marks: ";
        cin >> marks;
    }

    void display() {
        cout << "Roll No: " << roll << "\nName: " << name << "\nMarks: " << marks << "\n";
    }
};

void addRecord() {
    Student s;
    ofstream fout("students.txt", ios::app);
    s.input();
    fout << s.roll << "," << s.name << "," << s.marks << "\n";
    fout.close();
    cout << "Record added successfully!\n";
}

void viewRecords() {
    ifstream fin("students.txt");
    string line;
    cout << "\n-- All Student Records --\n";
    while (getline(fin, line)) {
        cout << line << "\n";
    }
    fin.close();
}

void searchRecord() {
    ifstream fin("students.txt");
    int searchRoll;
    bool found = false;
    cout << "Enter Roll No to search: ";
    cin >> searchRoll;
    string line;
    while (getline(fin, line)) {
        int roll = stoi(line.substr(0, line.find(',')));
        if (roll == searchRoll) {
            cout << "Record Found: " << line << "\n";
            found = true;
            break;
        }
    }
    fin.close();
    if (!found) {
        cout << "Record not found.\n";
    }
}

void deleteRecord() {
    ifstream fin("students.txt");
    ofstream temp("temp.txt");
    int deleteRoll;
    bool deleted = false;
    cout << "Enter Roll No to delete: ";
    cin >> deleteRoll;
    string line;
    while (getline(fin, line)) {
        int roll = stoi(line.substr(0, line.find(',')));
        if (roll != deleteRoll) {
            temp << line << "\n";
        } else {
            deleted = true;
        }
    }
    fin.close();
    temp.close();
    remove("students.txt");
    rename("temp.txt", "students.txt");

    if (deleted) cout << "Record deleted successfully!\n";
    else cout << "Record not found.\n";
}

int main() {
    int choice;
    do {
        cout << "\n--- Student Record Management ---\n";
        cout << "1. Add Record\n2. View All Records\n3. Search Record\n4. Delete Record\n5. Exit\n";
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice) {
            case 1: addRecord(); break;
            case 2: viewRecords(); break;
            case 3: searchRecord(); break;
            case 4: deleteRecord(); break;
            case 5: cout << "Exiting...\n"; break;
            default: cout << "Invalid choice!\n";
        }
    } while (choice != 5);

    return 0;
}
